
# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php7_module>
   php_value error_log "/home/gauravwc/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/gauravwc/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Cache policy
# The server default is "Cache-Control: max-age=2592000" (30 days) on
# everything, including the HTML pages. Because this site is deployed by
# hand over FTP and the pages carry their CSS/JS/fonts inline, that
# default means a returning visitor keeps seeing the old page for up to a
# month after a deploy — the change looks like it silently did nothing.
# Force the documents and the two shared assets to revalidate instead.
# (Revalidation is cheap: unchanged files still answer 304 Not Modified.)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Old flat URLs, kept so bookmarks and search results still land on the work.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^hanuman-chalisa\.html$ /stotra/hanuman-chalisa/ [R=301,L]
  RewriteRule ^aditya-hridayam\.html$ /stotra/aditya-hridayam/ [R=301,L]
  RewriteRule ^sri-suktam\.html$ /stotra/sri-suktam/ [R=301,L]
  RewriteRule ^bajrang-baan\.html$ /stotra/bajrang-baan/ [R=301,L]
  RewriteRule ^divine-names\.html$ /stotra/divine-names/ [R=301,L]
  RewriteRule ^ganapati-atharvashirsha\.html$ /stotra/ganapati-atharvashirsha/ [R=301,L]
  RewriteRule ^rudrashtakam\.html$ /stotra/rudrashtakam/ [R=301,L]
  RewriteRule ^shiva-tandava-stotram\.html$ /stotra/shiva-tandava-stotram/ [R=301,L]
  RewriteRule ^nirvana-shatkam\.html$ /stotra/nirvana-shatkam/ [R=301,L]
  RewriteRule ^bhaja-govindam\.html$ /stotra/bhaja-govindam/ [R=301,L]
  RewriteRule ^bhagavad-gita-chapter-([123])\.html$ /gita/$1/ [R=301,L]
  RewriteRule ^vishnu-sahasranamam\.html$ /vishnu-sahasranama/ [R=301,L]
  RewriteRule ^vishnu-sahasranama-videos\.html$ /vishnu-sahasranama/guide/ [R=301,L]
  RewriteRule ^vishnu-sahasranam-verses/verse-([0-9]+)\.html$ /vishnu-sahasranama/verse/$1/ [R=301,L]
  RewriteRule ^verify\.html$ /tools/verify/ [R=301,L]
  RewriteRule ^seekerblog-theme\.css$ /assets/css/theme.css [R=301,L]
  RewriteRule ^gita-reader\.css$ /assets/css/gita-reader.css [R=301,L]
  RewriteRule ^gita-reader\.js$ /assets/js/gita-reader.js [R=301,L]
  RewriteRule ^seekerblog-(textsize|continuous|landscape|gesture)\.js$ /assets/js/seekerblog-$1.js [R=301,L]
  RewriteRule ^assets/audio/gita-chapter-([123])/([0-9]+)\.mp3$ /gita/$1/audio/$2.mp3 [R=301,L]
  RewriteRule ^assets/data/gita-chapter-([123])\.js$ /gita/$1/data.js [R=301,L]
  RewriteRule ^assets/data/gita-chapter-([123])-timings\.js$ /gita/$1/timings.js [R=301,L]
</IfModule>
